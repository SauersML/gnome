{
	"compatibility_date": "2025-10-08",
	"main": "src/server/index.ts",
	"name": "gnome-science",
	"migrations": [
		{
			"new_sqlite_classes": ["Chat"],
			"tag": "v1"
		},
		{
			"new_sqlite_classes": ["CogitoRelay"],
			"tag": "v2"
		}
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/parties/*", "/__cogito/*", "/transformer", "/transformer/*", "/transformer.html"],
		"not_found_handling": "single-page-application"
	},
	"build": {
		"command": "esbuild src/client/index.tsx --bundle --splitting --format=esm --platform=browser --outdir=public/dist"
	},
	"durable_objects": {
		"bindings": [
			{
				"class_name": "Chat",
				"name": "Chat"
			},
			{
				"class_name": "CogitoRelay",
				"name": "COGITO_RELAY"
			}
		]
	},
	"ai": {
		"binding": "AI"
	},
	"observability": {
		"enabled": false
	},
	"upload_source_maps": true
}
