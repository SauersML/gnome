{
	"compatibility_date": "2025-10-08",
	"main": "src/server/index.ts",
	"name": "gnome-science",
	"migrations": [
		{
			"new_sqlite_classes": ["Chat"],
			"tag": "v1"
		},
		{
			"new_sqlite_classes": ["CogitoRelay"],
			"tag": "v2"
		},
		{
			"new_sqlite_classes": ["BeeHive"],
			"tag": "v3"
		}
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/parties/*", "/__cogito/*", "/transformer", "/transformer/*", "/transformer.html", "/p/*"],
		"not_found_handling": "single-page-application"
	},
	"build": {
		"command": "node scripts/fetch-bee.mjs public BeeLLM-13M-Somnia-Q8_0 && esbuild src/client/index.tsx --bundle --splitting --format=esm --platform=browser --outdir=public/dist"
	},
	"durable_objects": {
		"bindings": [
			{
				"class_name": "Chat",
				"name": "Chat"
			},
			{
				"class_name": "CogitoRelay",
				"name": "COGITO_RELAY"
			},
			{
				"class_name": "BeeHive",
				"name": "BEE"
			}
		]
	},
	"kv_namespaces": [
		{
			"binding": "PAGES",
			"id": "b8d3d2f74d554213bb6735ef6a7bfdce"
		},
		{
			"binding": "ROW_BLOCKS",
			"id": "bc9ce7cf4612401c83c3758b078f15d4"
		}
	],
	"d1_databases": [
		{
			"binding": "EXPLORER",
			"database_name": "oracle-explorer",
			"database_id": "1eedb3fb-2b33-4da2-9842-91c4d25207f9"
		},
		{
			"binding": "ROWS",
			"database_name": "oracle-rows",
			"database_id": "87a7237d-e55a-414f-a359-5f64fd750eba"
		}
	],
	"limits": {
		"cpu_ms": 120000
	},
	"observability": {
		"enabled": false
	},
	"upload_source_maps": true
}
